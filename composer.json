{
    "name": "cleaniquecoders/inviteable",
    "description": "A polymorphic invitation system for Laravel. Any Eloquent model can have invitations.",
    "keywords": [
        "package",
        "laravel",
        "invite",
        "invitation",
        "polymorphic"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Nasrul Hazim",
            "email": "nasrulhazim.m@gmail.com",
            "homepage": "https://github.com/nasrulhazim",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/cleaniquecoders/inviteable",
    "autoload": {
        "psr-4": {
            "CleaniqueCoders\\Inviteable\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CleaniqueCoders\\Inviteable\\Database\\Factories\\": "database/factories/",
            "CleaniqueCoders\\Inviteable\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\App\\Database\\Seeders\\": "workbench/database/seeders/",
            "Workbench\\App\\Providers\\": "workbench/app/Providers/"
        }
    },
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0 || ^12.0||^13.0",
        "livewire/flux": "^2.0",
        "livewire/livewire": "^4.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^9.0 || ^10.0||^11.0",
        "pestphp/pest": "^3.0||^4.0",
        "pestphp/pest-plugin-arch": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "phpstan/phpstan": "^2.0"
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint",
        "dev:prepare": [
            "@php -r \"file_put_contents('vendor/orchestra/testbench-core/laravel/.env', \\\"APP_KEY=base64:\\\".base64_encode(random_bytes(32)).\\\"\\nAPP_DEBUG=true\\nDB_CONNECTION=sqlite\\nDB_DATABASE=workbench/database/database.sqlite\\nSESSION_DRIVER=file\\n\\\");\"",
            "@php -r \"@unlink('workbench/database/database.sqlite'); touch('workbench/database/database.sqlite');\"",
            "@php vendor/bin/testbench migrate:fresh --seeder=\"Workbench\\\\App\\\\Database\\\\Seeders\\\\DatabaseSeeder\""
        ],
        "dev": [
            "@dev:prepare",
            "bash bin/serve.sh"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "CleaniqueCoders\\Inviteable\\InviteableServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
