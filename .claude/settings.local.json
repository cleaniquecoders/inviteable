{
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:api.github.com)",
      "Bash(composer install:*)",
      "Bash(vendor/bin/pest:*)",
      "Bash(vendor/bin/pint:*)",
      "Bash(vendor/bin/phpstan analyse:*)",
      "Bash(composer dump-autoload:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "WebFetch(domain:fluxui.dev)",
      "Bash(composer update:*)",
      "Bash(git push:*)",
      "Bash(git rm:*)",
      "Bash(vendor/bin/testbench migrate:fresh:*)",
      "Bash(composer dev:prepare:*)",
      "Bash(timeout 5 composer dev:*)",
      "Bash(vendor/bin/testbench tinker:*)",
      "Bash(curl:*)",
      "Bash(grep:*)"
    ]
  }
}
