parameters:
	ignoreErrors:
		-
			message: '#^Trait CleaniqueCoders\\Inviteable\\Concerns\\HasInviteable is used zero times and is not analysed\.$#'
			identifier: trait.unused
			count: 1
			path: src/Concerns/HasInviteable.php

		-
			message: '#^Call to an undefined method Illuminate\\Database\\Eloquent\\Model\:\:invitations\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: src/InviteableManager.php

		-
			message: '#^PHPDoc tag @param for parameter \$inviteable contains unresolvable type\.$#'
			identifier: parameter.unresolvableType
			count: 1
			path: src/InviteableManager.php
